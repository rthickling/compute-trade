{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "acceptance",
      "inherits": "debug",
      "cacheVariables": {
        "COMPUTE_TRADE_ACCEPTANCE_LIVE": "ON"
      }
    },
    {
      "name": "sanitizers",
      "inherits": "debug",
      "cacheVariables": {
        "COMPUTE_TRADE_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "acceptance",
      "configurePreset": "acceptance"
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "acceptance",
      "inherits": "debug",
      "configurePreset": "acceptance",
      "filter": {
        "include": {
          "label": "^acceptance$"
        }
      }
    },
    {
      "name": "sanitizers",
      "inherits": "debug",
      "configurePreset": "sanitizers"
    }
  ]
}
