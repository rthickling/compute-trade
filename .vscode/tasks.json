{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure Debug",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "debug"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "CXX": "g++-16" }
      },
      "problemMatcher": []
    },
    {
      "label": "CMake: build Debug exchange",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "debug", "--target", "ct_exchange", "--parallel", "2"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["CMake: configure Debug"],
      "dependsOrder": "sequence",
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
