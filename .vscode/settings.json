    "${workspaceFolder}/tests"
  ],
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/include",
    "${workspaceFolder}/../simplx/include",
    "${workspaceFolder}/../simplx"
  ],
  "C_Cpp.intelliSenseEngine": "disabled",
  "python.defaultInterpreterPath": "/home/richard/.pyenv/versions/3.14.3/envs/test-python/bin/python",
  "yaml.schemas": {
    "": [
      ".clangd",
      "**/.clangd"
    ]
  }
